# ---------- Stage 1: Build ----------
FROM docker.io/library/golang:1.24 AS builder
WORKDIR /app
COPY . .
RUN mkdir -p build && \
    GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -ldflags="-s -w" -o build ./...

# ---------- Stage 2: Runtime Container ----------
FROM ubuntu:22.04 AS uc3-backend

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y ca-certificates procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create application user and directories
RUN groupadd -g 1001 ucm && \
    useradd -u 1001 -g ucm -d /home/ucm -s /bin/bash ucm

# Create necessary directories for batch processing
RUN mkdir -p /docker/starlight/config_files_starlight/ && \
    mkdir -p /processing_data/ && \
    mkdir -p /home/ucm && \
    chown -R ucm:ucm /processing_data /home/ucm && \
    chmod -R 775 /processing_data

# Copy built binary and configuration files
COPY --from=builder /app/build/ucm /usr/bin/ucm
COPY data/. /docker/starlight/config_files_starlight/
COPY uid_entrpoint.sh /uid_entrpoint.sh

COPY orchestrator.sh /orchestrator.sh

# Set proper permissions
RUN chmod +x /usr/bin/ucm /uid_entrpoint.sh && \
    chmod +x /usr/bin/ucm /orchestrator.sh && \
    chown -R ucm:ucm /docker/starlight/

# Set working directory
WORKDIR /processing_data

# Expose ports for server mode and RabbitMQ
EXPOSE 5672 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep ucm || exit 1


# Default entrypoint - supports watcher, consumer, server modes
ENTRYPOINT ["/uid_entrpoint.sh"]
CMD ["server"]