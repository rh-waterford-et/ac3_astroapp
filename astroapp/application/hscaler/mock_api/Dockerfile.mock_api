FROM python:3.11-slim

WORKDIR /app

# Copy requirements first for better caching
COPY requirements-mock-api.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-mock-api.txt

# Copy application code and model
COPY mock_api.py .
COPY model.pkl .

# Create a non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose the API port
EXPOSE 5000

# Run the application
CMD ["python", "-u", "mock_api.py"]
