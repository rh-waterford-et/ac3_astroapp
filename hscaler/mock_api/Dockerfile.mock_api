FROM python:3.11-slim

WORKDIR /app

# Install Flask
RUN pip install --no-cache-dir Flask==3.0.0

# Copy application code
COPY mock_api.py .

# Create a non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose the API port
EXPOSE 5000

# Run the application
CMD ["python", "-u", "mock_api.py"]
